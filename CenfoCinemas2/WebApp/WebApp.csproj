<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    If Windows Application Control policies mark newly-built assemblies as blocked (for example when files
    have a Zone.Identifier alternate data stream), this target runs after build and attempts to remove the
    block by calling PowerShell's Unblock-File on output assemblies. This is a mitigation for developer
    machines only; if your environment enforces WDAC/AppLocker, follow your org policy instead (move the
    repo to an allowed path or update the policy).
  -->
  <Target Name="UnblockOutputAssemblies" AfterTargets="Build" Condition=" '$(OS)' == 'Windows_NT' ">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem -Path \&quot;$(TargetDir)\&quot; -Filter *.dll -File -Recurse | ForEach-Object { if (Test-Path ($_.FullName + ':Zone.Identifier')) { Unblock-File -Path $_.FullName } }\"" />
  </Target>

</Project>
