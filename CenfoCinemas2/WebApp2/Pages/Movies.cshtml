@page
@model WebApp2.Pages.MoviesModel
@{
}

<script src="~/js/Page-controllers/MovieViewController.js"></script>

<h1>Mantenimiento de películas</h1>

<div class="bs-docs-section">
    <div class="row">
        <legend>Listado de películas</legend>

        <div class="col-lg-12">
            <table id="tblMovies" class="display" style="width:100%">
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Sinopsis</th>
                    <th>Género</th>
                    <th>Clasificación</th>
                    <th>Imagen</th>
                    <th>Estado</th>
                    <th>Fecha de Registro</th>
                </tr>
            </table>
        </div>
    </div>
    <div class="row">
    <div class="col-lg-6">
        <div class="bs-component">
            <form>
                <fieldset>
                    <legend>Edición</legend>

                    <div class="form-group">
                        <label for="txtId">Id</label>
                        <input id="txtId" readonly type="number" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="txtTitle">Título</label>
                        <input id="txtTitle" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="txtSynopsis">Sinopsis</label>
                        <textarea id="txtSynopsis" class="form-control"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="txtGender">Género</label>
                        <input id="txtGender" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="txtClasificacion">Clasificación</label>
                        <input id="txtClasificacion" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="txtImage">Imagen</label>
                        <input id="txtImage" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="txtStatus">Estado</label>
                        <input id="txtStatus" type="text" class="form-control" />
                    </div>

                </fieldset>
            </form>

            <br />

            <button id="btnCreate" class="btn btn-primary">Create</button>
            <button id="btnUpdate" class="btn btn-secondary">Update</button>
            <button id="btnDelete" class="btn btn-danger">Delete</button>

        </div>
    </div>
</div>
</div>