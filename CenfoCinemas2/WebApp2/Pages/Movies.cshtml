@page
@model WebApp2.Pages.MoviesModel
@{
}

<script src="~/js/Page-controllers/MovieViewController.js"></script>

<h1>Mantenimiento de películas</h1>

<div class="bs-docs-section">
    <div class="row">
        <legend>Listado de películas</legend>

        <div class="col-lg-12">
            <table id="tblMovies" class="display" style="width:100%">
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Sinopsis</th>
                    <th>Género</th>
                    <th>Clasificación</th>
                    <th>Imagen</th>
                    <th>Estado</th>
                    <th>Fecha de Registro</th>
                </tr>
            </table>
        </div>
    </div>
</div>